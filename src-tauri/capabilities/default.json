{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the quick capture window",
  "windows": [
    "main",
    "quick"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "sql:default",
    "sql:allow-execute",
    "core:window:allow-hide",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "autostart:default",
    "notification:default"
  ]
}
