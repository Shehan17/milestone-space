{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MilestoneSpace",
  "version": "0.1.0",
  "identifier": "com.shehan.milestonespace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MilestoneSpace",
        "visible": false,
        "dragDropEnabled": false,
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
